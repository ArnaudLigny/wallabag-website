{#- News index (layout: news): latest post, recent posts and the list of all posts -#}
{% extends 'page.html.twig' %}

{% block content %}
{%- set posts = site.pages.showable|filter_by('section', 'news')|sort_by_date -%}
{%- set latest = posts|first ~%}
        <section class="newsHome">
          <div class="newsIntro">
            <p class="newsEyebrow">Project updates</p>
            <h2>News, releases and migration notes from wallabag.</h2>
            <p>Follow the project, read release notes, and find practical updates for people moving from other read-it-later services.</p>
            <p><a href="{{ url(site.page(site.home), {format: 'rss'}) }}" class="newsRss">Subscribe with RSS <i class="fa fa-rss"></i></a></p>
          </div>

          <article class="newsFeatured">
            <p class="newsFeatured-label">Latest post</p>
            <h2><a href="{{ url(latest) }}">{{ latest.title }}</a></h2>
            <time datetime="{{ latest.date|date('c') }}">{{ latest.date|date }}</time>
            <p>{{ include('partials/summary.html.twig', {post: latest, length: 220}, with_context=false) }}</p>
          </article>

          <h2 class="newsSectionTitle">Recent posts</h2>
          <div class="newsCards">
            {%- for post in posts|slice(1, 8) ~%}
            <article class="newsCard">
              <time datetime="{{ post.date|date('c') }}">{{ post.date|date }}</time>
              <h3><a href="{{ url(post) }}">{{ post.title }}</a></h3>
              <p>{{ include('partials/summary.html.twig', {post: post, length: 150}, with_context=false) }}</p>
            </article>
            {%- endfor ~%}
          </div>

          <h2 class="newsSectionTitle">All posts</h2>
          <ul class="newsList">
            {%- for post in posts ~%}
            <li class="newsList-item">
              <a class="newsList-link" href="{{ url(post) }}">
                <span class="newsList-text">{{ post.title }}</span>
                <time class="newsList-time">{{ post.date|date }}</time>
              </a>
            </li>
            {%- endfor ~%}
          </ul>
        </section>
{% endblock %}
