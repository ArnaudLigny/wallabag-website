{#- Header: navigation, plus the hero on the homepage (`hero: true`) -#}
{%- set home = url(site.home) -%}
<header>
  <section class="hero{% if not hero %} no-bg{% endif %}">
    <div class="texture-overlay"></div>
    <div class="container">
      <div class="row nav-wrapper">
        <div class="col-md-3 col-sm-6 col-xs-6 text-left">
          <a href="{{ home }}">
            <img src="{{ url(asset(hero ? 'img/logo-wallabag.svg' : 'img/logo-wallabag-black.svg')) }}" alt="wallabag logo">
          </a>
        </div>
        <div class="col-md-9 col-sm-6 col-xs-6 text-right navicon">
          <nav class="site-nav{% if not hero %} site-nav-dark{% endif %}" aria-label="Primary navigation">
            <a href="{{ hero ? '' : home }}#features">Features</a>
            <a href="{{ hero ? '' : home }}#migration">Migration</a>
            <a href="{{ url('apps-and-readers') }}">Apps</a>
            <a href="{{ hero ? '#hosting' : url('self-hosting') }}">Hosting</a>
            <a href="{{ url('news') }}">News</a>
            <a href="https://doc.wallabag.org/">Docs</a>
          </nav>
          <a id="trigger-overlay" class="nav_slide_button nav-toggle{% if not hero %} nav-toggle-dark{% endif %}" href="#site-menu" aria-label="Open menu" aria-controls="site-menu" aria-expanded="false">
            <span></span>
          </a>
        </div>
      </div>
      <div class="row hero-content wp1">
        <div class="col-md-12">
        {% if hero %}
          <div class="hero-grid animated fadeIn">
            <div class="hero-copy">
              <p class="hero-eyebrow">Open source read-it-later</p>
              <h1>
                Save web articles. Read them later, your way.
              </h1>
              <p class="hero-summary">wallabag extracts the content you care about, keeps it in your own archive, and lets you read comfortably from your browser, phone, RSS reader, or e-reader.</p>
              <div class="hero-actions">
                <a href="#download" class="use-btn use-btn-primary">
                  Self-host wallabag
                  <i class="fa fa-download"></i></a>
                <a href="https://www.wallabag.it/en" class="use-btn use-btn-secondary">
                  Use wallabag.it
                  <i class="fa fa-cloud"></i></a>
              </div>
              <ul class="hero-proof">
                <li>No ads or tracking</li>
                <li>Import from Pocket and Omnivore</li>
                <li>Apps, extensions and e-readers</li>
                <li><a href="https://player.vimeo.com/video/167435064" class="youtube-media">Discover wallabag in video</a></li>
              </ul>
            </div>
            <div class="hero-product" aria-label="wallabag product previews">
              <img src="{{ url(asset('img/screenshot.png')) }}" width="2412" height="1762" alt="wallabag interface showing saved articles and reading controls">
            </div>
          </div>
        {% else %}
          <h1 class="animated fadeIn">
            {{ page.title|default(site.description) }}
          </h1>
          {% if page.section == 'news' %}<p class="text-center">{{ page.date|date }}</p>{% endif %}
        {% endif %}
        </div>
      </div>
    </div>
  </section>
</header>
