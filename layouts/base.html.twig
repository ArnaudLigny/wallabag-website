{#- Base layout: every HTML template extends it -#}
{%- set hero = hero ?? false -%}
<!DOCTYPE html>
<html lang="{{ page.lang|default(site.language) }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- block metatags ~%}
    {{- include('partials/metatags.html.twig') ~}}
    {%- endblock ~%}
    <meta name="generator" content="Cecil {{ cecil.version }}">
    <link rel="stylesheet" href="{{ url(asset('css/main.css')) }}">
    <link rel="stylesheet" href="{{ url(asset('css/fork-awesome.css')) }}">
    {%- block stylesheets %}{% endblock ~%}
    <!-- Matomo -->
    <script>
      var _paq = window._paq = window._paq || [];
      /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function() {
        var u="https://pwk.wallabag.it/";
        _paq.push(['setTrackerUrl', u+'matomo.php']);
        _paq.push(['setSiteId', '13']);
        var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
        g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
      })();
    </script>
    <!-- End Matomo Code -->
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {{~ include('partials/header.html.twig', {hero: hero}) }}
    {%- block body %}{% endblock ~%}
    {{~ include('partials/footer.html.twig') }}
  </body>
</html>
